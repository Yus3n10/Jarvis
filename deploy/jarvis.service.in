[Unit]
Description=Jarvis calendar butler
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@HOME@/jarvis
ExecStart=@HOME@/jarvis/.venv/bin/python -m jarvis
Restart=always
RestartSec=5
Environment=PIPER_BIN=@HOME@/piper/piper
Environment=PIPER_MODEL=@HOME@/piper/en_US-lessac-medium.onnx
# Quoted: systemd splits Environment= on whitespace, so an unquoted value would
# set AUDIO_PLAYER=aplay and silently discard the arguments.
Environment="AUDIO_PLAYER=aplay -q -"
# Without this, aplay cannot find the user's PipeWire socket
# ($XDG_RUNTIME_DIR/pipewire-0) and so cannot see Bluetooth or USB sinks at all
# -- it falls back to bare ALSA and only ever finds HDMI. This is a system
# service, so it depends on @USER@ being logged in to a graphical session for
# that socket to exist; on a kiosk Pi with autologin, it does.
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
# Optional drive monitoring: which drives to watch, as name:mountpoint[:device],
# comma-separated. Empty (the default below) disables it entirely.
#
# The device is what smartctl reads. Omit it for something with no SMART, such as
# a USB stick, and free space is still reported. Prefer a /dev/disk/by-id path
# over /dev/sdX: sd letters are handed out in spin-up order and shuffle the
# moment a second USB disk is attached. Find yours with `ls -l /dev/disk/by-id/`.
#
# A wildcard mountpoint picks up whatever the desktop automounter has mounted, so
# a disk plugged in later is monitored without editing this file.
#
#   Environment=NAS_DRIVES=movies:/srv/nas/movies:/dev/disk/by-id/usb-Example_1234-0:0
#   Environment=NAS_DRIVES=movies:/srv/nas/movies,usb:/media/@USER@/*
#
Environment=NAS_DRIVES=
# How far the speaker lags the audio, in milliseconds, used to line the dashboard
# orb up with the voice. Raise it if the orb leads, lower it if the orb trails.
# Bluetooth is typically 150-250; a wired or USB speaker is closer to 0.
Environment=SPEECH_LATENCY_MS=200
# The optional Gemini conversation key. The leading '-' makes it optional: the
# service starts fine without the file, and voice conversation simply stays off.
# The file is gitignored and never committed.
EnvironmentFile=-@HOME@/jarvis/.gemini_env

[Install]
WantedBy=multi-user.target
